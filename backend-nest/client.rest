@baseUrl = http://localhost:3000

# RECADOS
### Lista todos os recados
GET {{baseUrl}}/recados/
?limit=10
&offset=0
### Lista apenas um recado
 GET {{baseUrl}}/recados/2/
### Cria um recado
POST {{baseUrl}}/recados/
Content-Type: application/json

{
    "texto": "NOVO Recado",
    "de": "Joana",
    "para": "João",
    "lido": false,
    "data": "2024-08-08T11:32:39.624Z"
}
### Atualiza um recado

PATCH {{baseUrl}}/recados/2/
Content-Type: application/json

{
    "recado": "Este é o recado que est enviando.",
    "atualizar": true,
    "texto": "ATUALIZAR Recado",
    "de": "Joana",
    "para": "João",
    "lido": false,
    "data": "2024-08-08T11:32:39.624Z"
}
### Apaga um recado
DELETE {{baseUrl}}/recados/2/

